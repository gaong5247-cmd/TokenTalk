rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(id) { return signedIn() && request.auth.uid == id; }
    function validPost() {
      return request.resource.data.keys().hasOnly(['author','title','body','category','createdAt'])
        && request.resource.data.keys().hasAll(['author','title','body','category','createdAt'])
        && request.resource.data.author == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.body is string && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 20000
        && request.resource.data.category is string && request.resource.data.category.size() <= 60
        && request.resource.data.createdAt == request.time;
    }
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 32
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
      match /blocks/{blockedUid} {
        allow read: if owner(uid);
        allow create: if owner(uid) && blockedUid != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if owner(uid);
        allow update: if false;
      }
    }
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && validPost();
      allow update, delete: if false;
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && request.resource.data.keys().hasOnly(['author','body','createdAt'])
          && request.resource.data.keys().hasAll(['author','body','createdAt'])
          && request.resource.data.author == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 5000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporter','type','targetId','reason','createdAt','status'])
        && request.resource.data.keys().hasAll(['reporter','type','targetId','reason','createdAt','status'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.type in ['post','comment','user']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3 && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
